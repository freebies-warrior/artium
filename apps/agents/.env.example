# Core app (required for API auth + backend callbacks)
INTERNAL_TOKEN=freebies
BACKEND_URL=http://localhost:8080
LOG_LEVEL=INFO
APP_ENV=dev

# Visualizer / feature extractor (required for Gemini calls)
GOOGLE_API_KEY=<GOOGLE_API_KEY>
VISUALIZER_GEMINI_MODEL=gemini-2.0-flash-exp-image-generation
VISUALIZER_GEMINI_TEXT_MODEL=gemini-2.5-flash
VISUALIZER_MAX_RETRIES=1
VISUALIZER_ENHANCE_IF_LOW_QUALITY=true
VISUALIZER_USE_LANGGRAPH=true

# Search enrichment (optional unless SerpAPI search is used)
SERPAPI_API_KEY=<SERPAPI_API_KEY>

# RAG / valuation providers (required when RAG tooling is used)
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
PINECONE_API_KEY=<PINECONE_API_KEY>
MANUS_API_KEY=<MANUS_API_KEY>
MANUS_BASE_URL=https://api.manus.im
VECTORDB_CONFIG=agents/providers/rag/config.yaml
